# File location: .npmrc
# File function: Ajusta la configuracion de pnpm para el proyecto, activando el
# modo estricto de versiones de motor y evitando la instalacion automatica de
# dependencias peer no declaradas para mantener el arbol de dependencias
# reproducible y explicito entre entornos.
# All Rights Reserved arodoo

engine-strict=true
auto-install-peers=false
strict-peer-dependencies=false
