# File location: .editorconfig
# File function: Define las reglas de edicion basicas compartidas por todos los
# editores e IDE del proyecto, fijando la indentacion de dos espacios, el salto
# de linea LF, la codificacion UTF-8 y el recorte de los espacios finales.
# All Rights Reserved arodoo

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
