# Conexion a PostgreSQL local (docker compose o instalacion nativa).
# Reemplaza la contrasena `changeme` por la que uses en tu instalacion y
# ajusta el usuario y el puerto si difieren de los del compose de este repositorio.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/threed_template?schema=public"

# URL base del sitio. Se usa para metadatos Open Graph, sitemap y canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nivel de log del servidor: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Secreto de firma para las Server Actions. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
